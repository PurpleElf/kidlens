# 本地存储（路径 A：无需 MinIO / Docker）
# 原始素材放 inbox/，去重后归档到 archive/，产物在 output/

# 路径
WATCH_DIR=./data/inbox
DATA_DIR=./data

# VLM 方案：template（默认，离线可演示）| cloud（需 key）| local（需 mlx-vlm）
VLM_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 本地 MLX 模型（VLM_PROVIDER=local 时生效）
LOCAL_VLM_MODEL=mlx-community/Qwen2.5-VL-3B-Instruct-4bit

# 人脸阈值（需实测校准，以 config/config.yaml 为准，此处保持同步）
FACE_THRESHOLD_HIGH=0.40
FACE_THRESHOLD_LOW=0.25
